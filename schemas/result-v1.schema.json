{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landmine.dev/schemas/result-v1.schema.json",
  "title": "LandmineResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_status",
    "command",
    "generated_at",
    "repository",
    "request",
    "summary",
    "risk",
    "findings",
    "evidence",
    "plan",
    "limitations",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "landmine.result.v1"},
    "analysis_id": {"type": "string", "pattern": "^lm_[0-9a-f]{12}$"},
    "analysis_status": {"enum": ["complete", "partial", "failed"]},
    "command": {"enum": ["why", "assumptions", "blast", "defuse"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"$ref": "#/$defs/repository"},
    "request": {"type": "object"},
    "summary": {"type": "string"},
    "risk": {"$ref": "#/$defs/risk"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "plan": {"$ref": "#/$defs/plan"},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "error": {"$ref": "#/$defs/error"},
    "evolution": {
      "type": "array",
      "items": {"$ref": "#/$defs/evolutionCommit"}
    },
    "assumption_analysis": {"$ref": "#/$defs/assumptionAnalysis"}
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head", "base", "dirty", "shallow"],
      "properties": {
        "root": {"type": "string"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "shallow": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "grade", "components"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "grade": {"enum": ["low", "moderate", "high", "critical"]},
        "components": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/scoreComponent"}
        }
      }
    },
    "scoreComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "weight", "signals"],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "claim",
        "status",
        "confidence",
        "impact",
        "evidence_ids",
        "tags"
      ],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "title": {"type": "string"},
        "claim": {"type": "string"},
        "status": {"enum": ["verified", "inferred", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "impact": {"enum": ["direct", "behavioral", "operational", "unknown"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "assumption": {"$ref": "#/$defs/assumptionDetail"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "observed_at",
        "excerpt",
        "excerpt_sha256",
        "command"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ev_[0-9a-f]{12}$"},
        "kind": {
          "enum": [
            "source",
            "test",
            "git_commit",
            "git_diff",
            "git_blame",
            "reference",
            "config",
            "documentation",
            "command_output"
          ]
        },
        "locator": {"type": "object"},
        "observed_at": {"type": "string", "format": "date-time"},
        "excerpt": {"type": ["string", "null"]},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "command": {"type": ["string", "null"]}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "affected"],
      "properties": {
        "code": {
          "enum": [
            "shallow_history",
            "budget_exhausted",
            "unsupported_language",
            "unresolved_target",
            "missing_base",
            "provider_failure",
            "binary_or_generated"
          ]
        },
        "message": {"type": "string"},
        "affected": {"type": "array", "items": {"type": "string"}}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "tests", "steps", "verification", "rollback_triggers"],
      "properties": {
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "string"}},
        "rollback_triggers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "files_scanned", "commits_scanned", "evidence_count"],
      "properties": {
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "files_scanned": {"type": "integer", "minimum": 0},
        "commits_scanned": {"type": "integer", "minimum": 0},
        "evidence_count": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "matching_text", "match_kind"],
      "properties": {
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "matching_text": {"type": "string"},
        "match_kind": {"enum": ["definition", "reference"]}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "candidates"],
      "properties": {
        "code": {
          "enum": [
            "ambiguous_symbol",
            "symbol_not_found",
            "symbol_search_budget_exhausted"
          ]
        },
        "message": {"type": "string"},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    },
    "evolutionCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "timestamp",
        "subject",
        "path",
        "start_line",
        "end_line",
        "roles",
        "evidence_ids"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "timestamp": {"type": "string", "format": "date-time"},
        "subject": {"type": "string"},
        "path": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "roles": {
          "type": "array",
          "items": {"enum": ["introduction", "intermediate", "latest"]}
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "assumptionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_id",
        "category",
        "observed_signal",
        "violation_scenario",
        "consequence",
        "confidence_ceiling",
        "protection",
        "candidate_tests",
        "uncertainty",
        "scope"
      ],
      "properties": {
        "detector_id": {"type": "string"},
        "category": {
          "enum": [
            "input",
            "data",
            "ordering",
            "time",
            "concurrency",
            "environment",
            "filesystem",
            "network",
            "external_contract",
            "authorization"
          ]
        },
        "observed_signal": {"type": "string"},
        "violation_scenario": {"type": "string"},
        "consequence": {"type": "string"},
        "confidence_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "protection": {"enum": ["protected", "unprotected", "unknown"]},
        "candidate_tests": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "base_expression": {"type": "string"},
        "required_key": {"type": "string"},
        "http_library": {"type": "string"},
        "http_method": {"type": "string"},
        "selection_operation": {"type": "string"},
        "suggested_alternatives": {
          "type": "array",
          "items": {"type": "string"}
        },
        "path_literal": {"type": "string"},
        "access_operation": {"type": "string"},
        "api_binding": {"type": "string"},
        "path_anchor": {"type": "string"},
        "clock_source": {"type": "string"},
        "clock_unit": {"type": "string"},
        "time_operation": {"enum": ["duration", "deadline"]}
      }
    },
    "assumptionAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectors_run", "categories_scanned", "suppression_count"],
      "properties": {
        "detectors_run": {"type": "array", "items": {"type": "string"}},
        "categories_scanned": {
          "type": "array",
          "items": {
            "enum": [
              "input",
              "data",
              "ordering",
              "time",
              "concurrency",
              "environment",
              "filesystem",
              "network",
              "external_contract",
              "authorization"
            ]
          }
        },
        "suppression_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
